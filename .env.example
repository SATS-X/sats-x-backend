# ---- Server ----
PORT=4000
NODE_ENV=development

# Origin được phép gọi API, phân tách bằng dấu phẩy.
# Phải liệt kê cụ thể vì cookie refresh token cần credentials (không dùng '*' được).
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL="postgresql://postgres:devpw@localhost:15432/attendance_system?schema=public"

# ---- JWT ----
# Sinh mỗi secret bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Hai secret PHẢI khác nhau và tối thiểu 32 ký tự.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---- Thiết bị IoT (Lambda gọi vào /api/device/*) ----
# Cùng giá trị với backend_service_token trong Terraform.
SERVICE_TOKEN=

# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call the API.
# Explicit origins are required because refresh-token cookies use credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://postgres:devpw@localhost:15432/attendance_system?schema=public"

# ---- JWT ----
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Secrets must be different and at least 32 characters long.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---- IoT devices (Lambda calls /api/device/*) ----
# Must match backend_service_token in Terraform.
SERVICE_TOKEN=
